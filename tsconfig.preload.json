{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist/preload",
    "module": "CommonJS",
    "target": "ES2020",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "allowImportingTsExtensions": false,
    "jsx": "preserve"
  },
  "include": ["src/preload/**/*"],
  "exclude": ["src/renderer/**/*", "src/main/**/*", "src/**/*.test.ts", "src/**/*.spec.ts"]
}